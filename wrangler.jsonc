{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worktools-app",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.worktools.my.id",
      "custom_domain": true
    }
  ]
}
