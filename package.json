{
  "name": "tenggoo_pdf",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "bin": {
    "tenggoo": "./bin/tenggoo.mjs",
    "tenggoo-mcp": "./bin/tenggoo-mcp.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "tsc -b && vite build",
    "build:landing": "tsc -b && vite build --config vite.landing.config.ts",
    "deploy": "npm run deploy:all",
    "deploy:app": "npm run build && npx wrangler deploy",
    "deploy:landing": "npm run build:landing && npx wrangler deploy --config wrangler.landing.jsonc",
    "deploy:all": "npm run deploy:app && npm run deploy:landing",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tenggoo": "node --no-warnings --experimental-strip-types src/agent/cli.ts",
    "mcp": "node --no-warnings --experimental-strip-types src/agent/mcp-server.ts",
    "test": "node --no-warnings --experimental-strip-types --test src/agent/toolkit.test.ts"
  },
  "dependencies": {
    "@jspawn/ghostscript-wasm": "^0.0.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
